<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo de Botón de Google -->
    <style name="MyButtonStyle">
        <item name="maxHeight">100dp</item>
        <item name="maxWidth">100dp</item>

        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="backAndCloseButton" parent="MyButtonStyle">
        <item name="android:textColor">@color/blue</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="MyCardsViews">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">3dp</item>
    </style>

    <!-- Styles TextViews -->
    <style name="MyTitleTextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingVertical">2.5dp</item>
        <item name="fontFamily">@font/dancing</item>
    </style>

    <style name="MyBodyTextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="android:paddingVertical">2.5dp</item>
        <item name="fontFamily">@font/dancing</item>
    </style>
</resources>